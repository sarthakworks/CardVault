{
  "cli": {
    "version": ">=25.2.0",
    "appVersionSource": "remote"
  },
  "build": {
    "release": {
      "distribution": "internal",
      "environment": "production",
      "credentialsSource": "remote",
      "autoIncrement": true,
      "node": "24.14.1",
      "buildArtifactPaths": [
        "android/app/build/outputs/apk/release/app-*-release.apk"
      ],
      "android": {
        "buildType": "apk",
        "resourceClass": "medium",
        "applicationArchivePath": "android/app/build/outputs/apk/release/app-arm64-v8a-release.apk"
      }
    }
  }
}
